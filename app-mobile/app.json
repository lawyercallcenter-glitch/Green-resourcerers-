{
  "expo": {
    "name": "Green Resourcerers",
    "slug": "green-resourcerers",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a5c2a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.greenresourcerers.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a5c2a"
      },
      "package": "com.greenresourcerers.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router"],
    "scheme": "green-resourcerers",
    "extra": {
      "apiBaseUrl": "http://localhost:8000"
    }
  }
}
